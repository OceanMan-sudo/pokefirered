mapscripts VermillionCity_BerryHouse_MapScripts{}

script VermillionBerryHouse_LittleGirl {
    lock
    faceplayer
    msgbox(format("I gave my POKéMON an IAPAPA BERRY to hold but it ended up getting confused after eating the berry!"))
    release
    end
}

script VermillionBerryHouse_Nidoran {
    lock
    faceplayer
    playmoncry(SPECIES_NIDORAN_F, CRY_MODE_NORMAL)
    msgbox(format("Nido!"))
	delay(40)
    release
    end
}

script VermillionBerryHouse_Sailor {
    lock
    faceplayer
    msgbox(format("Have you been onboard the S.S. ANNE? There are lots of tough trainers on the ship, so I make sure to stock up on berries just in case."))
    release
    end
}

script VermillionBerrySister {
    lock
    faceplayer
    msgbox(format("Welcome to the VERMILION CITY BERRY HOUSE! How can I assist you?"))
    waitmessage
    pokemart(VermillionBerryHouse_Mart)
    msgbox(format("Please come again!")) 
    release
    end
}

raw `
.align 2
VermillionBerryHouse_Mart::
    .2byte ITEM_FIGY_BERRY
    .2byte ITEM_WIKI_BERRY
    .2byte ITEM_MAGO_BERRY
    .2byte ITEM_AGUAV_BERRY
    .2byte ITEM_IAPAPA_BERRY
    .2byte ITEM_ORAN_BERRY
    .2byte ITEM_NONE
    release
    end
    `