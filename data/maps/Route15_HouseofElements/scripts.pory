script ElementalLady {
    lock
    faceplayer
    msgbox(format("They meditate for hours, then scream ‘FIRE PUNCH! or ICE PUNCH!’ and sock the wall. I don’t get it either..."))
    release
    end
}

script ElementalKid {
    lock
    faceplayer
    msgbox(format("The blackbelts here say they learned from locations like the LIN KUEI TEMPLE or the SHIRAI RYU FIRE GARDENS. Those aren't any places I've heard of."))
    release
    end
}