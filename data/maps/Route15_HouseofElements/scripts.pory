    if (var(VAR_RESULT) == FALSE) {
        goto(EventScript_IcePunchDeclined)
    }

    goto(EventScript_FirePunchTaught)
    end
}

script EventScript_FirePunchTaught {
	msgbox(format("Use this move well. It was passed down to me from the masters of the {COLOR RED}{SHADOW LIGHT_RED}SHIRAI RYU FIRE GARDEN."))
	release
	end
}

