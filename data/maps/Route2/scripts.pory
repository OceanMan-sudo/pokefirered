raw ` Route2_MapScripts::
	.byte 0

Route2_EventScript_RouteSign::
	msgbox Route2_Text_RouteSign, MSGBOX_SIGN
	end

Route2_EventScript_DiglettsCaveSign::
	msgbox Route2_Text_DiglettsCave, MSGBOX_SIGN
	end
`

script PicnickerSally{
	trainerbattle_single(TRAINER_PICNICKER_SALLY, PicnickerSallyIntro, PicnickerSallyDefeated)
	msgbox(PicnickerSallyPostBattle, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
text PicnickerSallyIntro {
    "I'll be your first opponent!"
}

text PicnickerSallyDefeated {
    "One trainer down, many more to go!"
}

text PicnickerSallyPostBattle {
    "I'd stock up on ANTIDOTEs \nbefore heading into VIRIDIAN\lFOREST if I were you."
}

script Tester {
if (defeated(TRAINER_PICNICKER_SALLY))
{
  lock
    faceplayer
    msgbox(format("Got em"))
	release
	end
}
else
{
  lock
    faceplayer
    msgbox (format("Kick her butt"))
	release
	end
	}
}