mapscripts CeruleanCity_BattleHouse_MapScripts{}

script CeruleanCityBattleHouseClerk {
    lock
    faceplayer
    if (flag(FLAG_0x0B4)) {
        msgbox(format("Congratulations on completing the CERULEAN CITY BATTLE HOUSE. We hope you enjoy your prize!"))
    release 
    end}
    elif ((defeated(TRAINER_BLACK_BELT_ROGAN)) && (defeated(TRAINER_HIKER_JONES)) && (defeated(TRAINER_YOUNGSTER_JAMIE))){
    msgbox(format("Congratulations on defeating each of the trainers in the CERULEAN CITY BATTLE HOUSE! Please accept this SHELL BELL as a reward for completing our challenge!"))
            giveitem(ITEM_SHELL_BELL, 1)
msgbox(format("We do hope you enjoy your prize!"))
        setflag(FLAG_0x0B4)
        release
        end }
else {
    msgbox(format("Welcome to the CERULEAN CITY BATTLE HOUSE! Defeat all three trainers and win a fabulous prize! Fair warning; some of the trainers in here are a little off their rocker!"))
    release
    end
}
}

script NonTrainer {
    lock
    faceplayer
    msgbox(format("Oh, I'm not a trainer. I just like hanging out at these new BATTLE HOUSE facilities while listening to my favorite Podcasts."))
    release
    end
}

script NonTrainer2 {
    lock
    faceplayer
    msgbox(format("There are new BATTLE HOUSE facilities spread across KANTO that offer really powerful items as prizes. The prize at this facility is the SHELL BELL which heals a POKéMON by a little bit any time it inflicts damage on an opponent. Pretty convenient!"))
release
end
}

script YoungsterJamie {
    lock  
     faceplayer
    trainerbattle_single(TRAINER_YOUNGSTER_JAMIE, JamieIntro, JamieDefeated)
    msgbox(JamiePostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

text JamieIntro {
    format("Want a battle? Sure, let me pull that up for you!")
}

text JamieDefeated {
    format("Wait, let me pull that up!")
}

text JamiePostBattle {
    format("To be honest, I stopped listening to the podcast too...")
}

script JoeRogan {
    lock  
     faceplayer
    trainerbattle_single(TRAINER_BLACK_BELT_ROGAN, RoganIntro, RoganDefeated)
    msgbox(RoganPostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

text RoganIntro {
    format("You ever seen a PRIMEAPE out in the wild? They will literally rip your face off!")
}

text RoganDefeated {
    format("Jamie pull that up!")
}

text RoganPostBattle{
    format("You killed, bro. You killed!")
}

script AlexJones {
    lock
         faceplayer
    trainerbattle_single(TRAINER_HIKER_JONES, JonesIntro, JonesDefeated)
    msgbox(JonesPostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

text JonesIntro {
    format("It's over for the globalist!")
}

text JonesDefeated {
    format("They must have rigged the damage rolls... It’s all a setup!")
}

text JonesPostBattle {
    format("You may have won, but the global POKéMON LEAGUE is still controlling everything!")
}