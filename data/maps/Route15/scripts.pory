raw `Route15_MapScripts::
	.byte 0

Route15_EventScript_RouteSign::
	msgbox Route15_Text_RouteSign, MSGBOX_SIGN
	end
`
script ElementHouse{
    lock
    faceplayer
    msgbox(format("The House of Elements"))
    release
    end
}

script BattleGirlElements {
    lock
    faceplayer
  msgbox(format("The blackbelts in this house are practitioners of the elemental punches. They taught my MANKEY the move THUNDERPUNCH!"))
release
end
}