mapscripts SaffronCity_BattleHouse_MapScripts{}

script SaffronCityBattleHouseClerk {
    lock
    faceplayer
    if (flag(FLAG_0x0B3)) {
        msgbox(format("Congratulations on completing the SAFFRON CITY BATTLE HOUSE. We hope you enjoy your prize!"))
    release 
    end}
    elif ((defeated(TRAINER_COOLTRAINER_DUKE)) && (defeated(TRAINER_COOLTRAINER_SYLVIA)) && (defeated(TRAINER_PLAYER_BRENDAN)) && (defeated(TRAINER_PLAYER_MAY))){
    msgbox(format("Congratulations on defeating each of the trainers in the SAFFRON CITY BATTLE HOUSE! Please accept this BRIGHT POWDER as a reward for completing our challenge!"))
            giveitem(ITEM_BRIGHT_POWDER, 1)
msgbox(format("We do hope you enjoy your prize!"))
        setflag(FLAG_0x0B3)
        release
        end }
else {
    msgbox(format("Welcome to the SAFFRON CITY BATTLE HOUSE! Defeat all four trainers and win a fabulous prize! Fair warning; the trainers in here are tough!"))
    release
    end
}
}
script SaffronMay{
    lock
    faceplayer
	trainerbattle_single(TRAINER_PLAYER_MAY, MayIntro, MayDefeated)
	msgbox(MayPostBattle, MSGBOX_AUTOCLOSE) 
	waitmessage
    release
    end
 
}

script SaffronBrendan{
    lock
    faceplayer
	trainerbattle_single(TRAINER_PLAYER_BRENDAN, BrendanIntro, BrendanDefeated)
	msgbox(BrendanPostBattle, MSGBOX_AUTOCLOSE) 
	waitmessage
    release
    end
}

script CoolTrainerDuke {
    lock
    faceplayer
    trainerbattle_single(TRAINER_COOLTRAINER_DUKE, DukeIntro, DukeDefeated)
    msgbox(DukePostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

script CoolTrainerSylvia {
    lock  
     faceplayer
    trainerbattle_single(TRAINER_COOLTRAINER_SYLVIA, SylviaIntro, SylviaDefeated)
    msgbox(SylviaPostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

text MayIntro {
    format("You're saying I look familiar? Odd. This is my first time in the KANTO region!")
}

text MayDefeated {
    "Wow, you're tough!"
}

text MayPostBattle {
    format("You should visit the HOENN region sometime. There are tons of tough trainers and rare POKéMON to catch!")
}

text BrendanIntro {
    format("My neighbor and I are on vacation from the HOENN region. Let's see what you got!")
}

text BrendanDefeated {
    format("Wow, you're no joke!")
}

text BrendanPostBattle {
    format("I wish I could stick around KANTO a bit longer, but I'll need to return to LITTLEROOT TOWN soon.")
}

text DukeIntro {
    format("This music is just so catchy!")
}

text DukeDefeated {
    format("This tune is gonna be stuck in my head all day!")
}

text DukePostBattle {
    format("You never really get to see this room in regular playthroughs do you?")
}

text SylviaIntro {
    format("Am I crazy or are those two HOENN trainers super familiar?")
}

text SylviaDefeated {
    format("Seriously, that's BRENDAN and MAY from HOENN!")
}

text SylviaPostBattle {
    format("I wonder what those two are doing here in SAFFRON CITY?")
}